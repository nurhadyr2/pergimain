# Salin menjadi .env lalu isi.
# -------------------------------------------------------------------
# Koneksi Postgres Supabase (Sequelize konek langsung ke Postgres).
# Ambil dari Supabase: Project Settings -> Database -> Connection string
#   Gunakan mode "Session" / direct (port 5432) untuk migrasi.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase butuh SSL. Biarkan true kecuali DB lokal tanpa SSL.
DB_SSL=true

# PIN buat buka aplikasi (satu PIN berdua, minimal 4 digit).
# Ganti PIN = semua HP harus masukkan PIN lagi.
APP_PIN=1234

# Foto jurnal (opsional). Kalau diisi, foto disimpan di Supabase Storage (bucket dibuat otomatis).
# Ambil dari Supabase: Project Settings -> API -> Project URL & service_role key (RAHASIA, jangan ke frontend).
# Kalau dikosongkan, foto disimpan di disk server: backend/uploads/
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=kenangan

# Server
PORT=4000
NODE_ENV=development

# Origin frontend yang diizinkan (pisah koma). * = semua (dev saja).
CORS_ORIGIN=http://localhost:5173
